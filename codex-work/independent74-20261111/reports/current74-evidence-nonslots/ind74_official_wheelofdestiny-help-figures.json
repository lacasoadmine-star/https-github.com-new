  "sections": [
    {
      "caption": "help.games.wheelofdestiny.third.section.header.title",
      "html": "<div class=\"headerRectangle\">\n                <div class=\"pageTitle\">\n                    <captionkey data-caption=\"help.games.wheelofdestiny.third.section.header.title\">PRIZES</captionkey> \n                </div>\n            </div>"
    },
    {
      "caption": "help.games.wheelofdestiny.page3.descr",
      "html": "<div class=\"section-3\">\n            <div class=\"headerRectangle\">\n                <div class=\"pageTitle\">\n                    <captionkey data-caption=\"help.games.wheelofdestiny.third.section.header.title\">PRIZES</captionkey> \n                </div>\n            </div>\n            <div class=\"pageText\">\n               <captionkey data-caption=\"help.games.wheelofdestiny.page3.descr\">The win is calculated by multiplying the bet placed on the winning sector by the sector multiplier.<br>The sectors in the wheel are distributed as follows:</captionkey>\n            </div>\n            <div class=\"prize-bg-main\">\n                <span><captionkey data-caption=\"help.games.wheelofdestiny.page3.sector\">SECTOR TYPE</captionkey></span>\n                <span><captionkey data-caption=\"help.games.wheelofdestiny.page3.sector.numbers\">NUMBER OF SECTORS</captionkey></span>\n            </div>\n            <div class=\"prize-bg-bonus\">\n                <span><captionkey data-caption=\"help.games.wheelofdestiny.page3.sector\">SECTOR TYPE</captionkey></span>\n                <span><captionkey data-caption=\"help.games.wheelofdestiny.page3.sector.numbers\">NUMBER OF SECTORS</captionkey></span>\n            </div>\n        </div>"
    },
    {
      "caption": "help.games.wheelofdestiny.fourth.section.header.title",
      "html": "<div class=\"headerRectangle\">\n                <div class=\"pageTitle\">\n                    <captionkey data-caption=\"help.games.wheelofdestiny.fourth.section.header.title\">BONUS GAME – “UP TO 1200x”</captionkey> \n                </div>\n            </div>"
    },
    {
      "caption": "help.games.wheelofdestiny.page4.desc",
      "html": "<div class=\"section-4\">\n            <div class=\"headerRectangle\">\n                <div class=\"pageTitle\">\n                    <captionkey data-caption=\"help.games.wheelofdestiny.fourth.section.header.title\">BONUS GAME – “UP TO 1200x”</captionkey> \n                </div>\n            </div>\n            <div class=\"page4-bonus-bg\"></div>\n            <div class=\"pageText without-bullet\">\n                <captionkey data-caption=\"help.games.wheelofdestiny.fourth.bonus.feature\">BONUS FEATURE</captionkey> \n            </div>\n            <div class=\"pageText bullet-text\">\n                <captionkey data-caption=\"help.games.wheelofdestiny.page4.desc\">Entering the Bonus (up to 1200x): <br> When the player enters the Bonus, the wheel will contain enhanced multipliers ranging from 10x up to 150x, as well as an additional special symbol — “Double.”</captionkey>\n            </div>\n            \n            <div class=\"page4-bonus-text-img\"></div>\n            <div class=\"pageText without-bullet\">\n                <captionkey data-caption=\"help.games.wheelofdestiny.fourth.bonus.symbol\">DOUBLE SYMBOL</captionkey> \n            </div>\n            <div class=\"pageText bullet-text\">\n                <captionkey data-caption=\"help.games.wheelofdestiny.page4.desc1\">Landing on the “Double” section doubles all current multipliers on the wheel.</captionkey> \n            </div>\n            <div class=\"pageText bullet-text\">\n                <captionkey data-caption=\"help.games.wheelofdestiny.page4.desc2\">The “Double” feature can be triggered a maximum of two times during the Bonus.</captionkey> \n            </div>\n            <div class=\"pageText without-bullet\">\n                <captionkey data-caption=\"help.games.wheelofdestiny.fourth.special.symbol\">SPECIAL CASE</captionkey> \n            </div>\n            <div class=\"pageText bullet-text\">\n                <captionkey data-caption=\"help.games.wheelofdestiny.page4.desc5\">If the wheel lands on the “Double” symbol twice in a row during the Bonus, then on the third and final spin, all “Double” sections on the wheel will automatically transform into 1200x multipliers.</captionkey> \n            </div>\n        </div>"
    }
  ],
