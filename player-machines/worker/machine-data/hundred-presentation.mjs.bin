import {drawBackground,drawSymbol} from './art.mjs';
import {metalText} from './cabinet.mjs';

// Cabinet measurements from the supplied Multi Hot 100 recording, normalized to
// 420 × 900. All outcomes, multipliers and amounts come from the round receipt.
export const hundredLayout = Object.freeze({
 width:420, height:900,
 visual:Object.freeze({x:3,y:249,w:414,h:336}),
 title:Object.freeze({x:85,y:106,w:252,h:31}),
 wheel:Object.freeze({cx:210,cy:400,outer:231,inner:141,step:.43,clip:[18,163,384,94]}),
 shield:Object.freeze({x:162,y:168,w:96,h:89}),
 spin:Object.freeze({x:210,y:754,r:59}),
 win:Object.freeze({x:126,y:590,w:168,h:34})
});

const finite = (value, fallback=0) => Number.isFinite(Number(value)) ? Number(value) : fallback;
const unit = value => Math.max(0, Math.min(1, finite(value)));
const money = value => Math.max(0, finite(value)).toFixed(2);
const TAU = Math.PI*2;

export function maskHundredComponent(image,name='') {
 const out=document.createElement('canvas');out.width=image.width;out.height=image.height;
 const c=out.getContext('2d');c.drawImage(image,0,0);
 const data=c.getImageData(0,0,out.width,out.height),pixels=data.data;
 for(let y=0;y<out.height;y++)for(let x=0;x<out.width;x++){
  const i=(y*out.width+x)*4,r=pixels[i],g=pixels[i+1],b=pixels[i+2];
  const alpha=name==='777'?Math.max((r-b*.8-28)/30,(g-b*.6-20)/25):name==='title'?(Math.max(r,b)-g*.48-39)/27:Math.max((r-g*.83-7)/10,(b-g*1.22-2)/12,(g-92)/18);
  // A two-pixel feather excludes compression at the crop edges, not the art.
  const edge=Math.min(1,x/2,y/2,(out.width-1-x)/2,(out.height-1-y)/2);
  pixels[i+3]=Math.round(pixels[i+3]*unit(alpha)*Math.max(0,edge));
 }
 c.putImageData(data,0,0);return out;
}

let hundredArtworkPromise;
export function loadHundredArtwork() {
 if(typeof Image==='undefined')return Promise.resolve(null);
 if(!hundredArtworkPromise)hundredArtworkPromise=Promise.all(Object.entries(hundredSourceArt).map(([name,src])=>new Promise(resolve=>{
  const image=new Image();image.onload=()=>resolve([name,maskHundredComponent(image,name)]);image.onerror=()=>resolve([name,null]);image.src=src;
 }))).then(entries=>({title:entries.find(([name])=>name==='title')?.[1],symbols:new Map(entries.filter(([name,image])=>name!=='title'&&image))}));
 return hundredArtworkPromise;
}

export function makeHundredAtlas(game) {
 const atlas=new Map();for(const name of game.symbols){
  const canvas=document.createElement('canvas');canvas.width=320;canvas.height=320;
  const c=canvas.getContext('2d');c.scale(3.2,3.2);drawSymbol(c,name,'emerald');atlas.set(name,canvas);
 }
 atlas.artworkLoaded=false;
 atlas.ready=loadHundredArtwork().then(art=>{
  if(!art)return false;let loaded=0;
  for(const [name,canvas]of atlas){const image=art.symbols.get(name);if(!image)continue;const c=canvas.getContext('2d');
   c.setTransform(1,0,0,1,0,0);c.clearRect(0,0,320,320);const scale=320/Math.max(image.width,image.height),w=image.width*scale,h=image.height*scale;
   c.drawImage(image,(320-w)/2,(320-h)/2,w,h);loaded++;
  }
  atlas.artworkLoaded=loaded===game.symbols.length;return atlas.artworkLoaded;
 });return atlas;
}

export function drawHundredBackground(c) {
 drawBackground(c,{visual:{skin:'emerald'}});
 // The recording has a brighter clover field around the outer board and controls.
 c.save();
 const glow=c.createRadialGradient(210,530,60,210,530,570);
 glow.addColorStop(0,'#07814c16');glow.addColorStop(.65,'#0b87551b');glow.addColorStop(1,'#00241905');
 c.fillStyle=glow;c.fillRect(0,0,420,900);c.restore();
}

// Reuses only the existing isolated MULTI HOT lettering; the new number is live
// Canvas typography. No captured background or game interface is included.
export function drawHundredTitle(c, art, box=hundredLayout.title) {
 const {x,y,w,h}=box;
 if(art?.title){
  c.drawImage(art.title,x,y,w,h);
 }else{
  metalText(c,'M U L T I  H O T',x+w*.39,y+h*.51,h*.91,w*.78);
  metalText(c,'100',x+w*.904,y+h*.51,h*.95,w*.25,{pink:true});
 }
 return true;
}

export function drawHundredMultiplier(c,value,x,y,size=43,active=true) {
 const number=Math.max(1,Math.trunc(finite(value,1))),text=String(number);
 // The recorded wheel uses a different numeral hue for each multiplier;
 // its small x remains gold. These colors never select or change a value.
 const colors={
  1:['#d5f4ff','#70c5f2','#397db8','#a2dcff','#255b91'],
  2:['#e0ffe3','#66ef86','#20a449','#9af5a3','#147a3e'],
  3:['#fffbc5','#ffe466','#c59129','#ffe88c','#b98424'],
  4:['#ffe6b6','#ffad47','#d46c1d','#ffc16e','#aa4e18'],
  5:['#ffd1d6','#ed6592','#d23972','#f792b3','#b23468']
 };
 const dim=color=>{const n=Number.parseInt(color.slice(1),16),rgb=[n>>16,(n>>8)&255,n&255],base=[13,37,26];return '#'+rgb.map((v,i)=>Math.round(v*.36+base[i]*.64).toString(16).padStart(2,'0')).join('');};
 const gradient=palette=>{const fill=c.createLinearGradient(0,-size*.52,0,size*.52);[0,.35,.5,.7,1].forEach((stop,i)=>fill.addColorStop(stop,active?palette[i]:dim(palette[i])));return fill;};
 c.save();c.translate(x,y);c.transform(1,0,-.1,1,0,0);
 c.textAlign='center';c.textBaseline='middle';c.lineJoin='round';
 c.font=`900 ${size}px Arial, sans-serif`;
 const numberWidth=c.measureText(text).width,xSize=size*.67;
 c.font=`900 ${xSize}px Arial, sans-serif`;
 const xWidth=c.measureText('x').width,total=numberWidth+xWidth-2;
 const draw=()=>{
  c.font=`900 ${size}px Arial, sans-serif`;c.textAlign='left';
  c.strokeText(text,-total/2,0);c.fillText(text,-total/2,0);
  c.font=`900 ${xSize}px Arial, sans-serif`;
  c.strokeText('x',-total/2+numberWidth-2,4);c.fillText('x',-total/2+numberWidth-2,4);
 };
 c.strokeStyle=active?'#3a4b29':'#263f29';c.lineWidth=5;c.fillStyle=active?'#e3e292':'#214d3c';draw();
 c.lineWidth=active?2.2:1.4;c.strokeStyle=active?'#fff5b1':'#88723e';
 c.fillStyle=gradient(colors[number]||colors[3]);draw();
 c.fillStyle=gradient(colors[3]);c.font=`900 ${xSize}px Arial, sans-serif`;c.textAlign='left';c.fillText('x',-total/2+numberWidth-2,4);
 c.restore();
}

function shieldPath(c,{x,y,w,h}) {
 c.beginPath();c.moveTo(x+5,y+10);c.quadraticCurveTo(x+w/2,y-7,x+w-5,y+10);
 c.quadraticCurveTo(x+w,y+12,x+w-3,y+22);c.lineTo(x+w*.77,y+h-2);
 c.lineTo(x+w*.23,y+h-2);c.lineTo(x+3,y+22);c.quadraticCurveTo(x,y+12,x+5,y+10);c.closePath();
}

export function drawHundredWheel(c,{phase=0,strip=[1,2,3,4,5],layout=hundredLayout}={}) {
 if(!Array.isArray(strip)||strip.length===0)return false;
 const v=layout.wheel,box=layout.shield,index=Math.floor(finite(phase)),fraction=finite(phase)-index;
 const value=offset=>strip[((index+offset)%strip.length+strip.length)%strip.length];
 c.save();c.beginPath();c.rect(...v.clip);c.clip();
 for(let i=-3;i<=3;i++){
  const angle=-Math.PI/2+(i-fraction)*v.step,a=angle-v.step/2,b=angle+v.step/2;
  c.beginPath();c.arc(v.cx,v.cy,v.outer,a,b);c.arc(v.cx,v.cy,v.inner,b,a,true);c.closePath();
  const f=c.createLinearGradient(0,169,0,270);f.addColorStop(0,'#064435');f.addColorStop(.7,'#0a3d30');f.addColorStop(1,'#092d24');
  c.fillStyle=f;c.fill();c.lineWidth=1.4;c.strokeStyle='#9a813c';c.stroke();
  c.save();c.translate(v.cx,v.cy);c.rotate((i-fraction)*v.step);
  c.globalAlpha=.78;drawHundredMultiplier(c,value(i),0,-v.outer+43,43,false);c.restore();
 }
 c.beginPath();c.arc(v.cx,v.cy,v.outer,-Math.PI,0);c.strokeStyle='#d1b66d';c.lineWidth=2.2;c.stroke();
 c.restore();
 c.save();shieldPath(c,box);c.strokeStyle='#102f24';c.lineWidth=9;c.stroke();
 c.strokeStyle='#842b57';c.lineWidth=6.6;c.stroke();c.strokeStyle='#f287ad';c.lineWidth=3.8;c.stroke();
 const jade=c.createLinearGradient(box.x,box.y,box.x+box.w,box.y+box.h);
 [[0,'#0c9456'],[.17,'#176a3e'],[.5,'#117347'],[1,'#064a32']].forEach(([at,color])=>jade.addColorStop(at,color));
 c.fillStyle=jade;c.fill();c.strokeStyle='#d9d389';c.lineWidth=1.5;c.stroke();
 c.save();shieldPath(c,{x:box.x+5,y:box.y+5,w:box.w-10,h:box.h-9});c.clip();
 const gloss=c.createLinearGradient(box.x,box.y,box.x+box.w,box.y+box.h);
 gloss.addColorStop(0,'#c8eda72c');gloss.addColorStop(.5,'#39aa3c00');gloss.addColorStop(1,'#001e1633');
 c.fillStyle=gloss;c.fillRect(box.x,box.y,box.w,box.h);
 // The highlighted value moves continuously through the fixed shield.
 for(let i=-1;i<=1;i++){
  c.save();c.translate(v.cx,v.cy);c.rotate((i-fraction)*v.step);
  drawHundredMultiplier(c,value(i),0,-v.outer+44,49,true);c.restore();
 }
 c.restore();c.restore();return true;
}

export function drawHundredSpinGlyph(c,{x=210,y=754,r=59,pressed=false,stopped=false}={}) {
 c.save();c.translate(x,y);if(pressed)c.scale(.97,.97);
 const olive=c.createRadialGradient(-r*.3,-r*.4,2,0,0,r);
 olive.addColorStop(0,'#587340');olive.addColorStop(.55,'#153d2b');olive.addColorStop(1,'#193f28');
 c.beginPath();c.arc(0,0,r,0,TAU);c.fillStyle=olive;c.fill();
 for(const [radius,width,color]of[[r-1,2,'#dfcb87'],[r-4,2,'#796c31'],[r-8,2,'#c1c690']]){
  c.beginPath();c.arc(0,0,radius,0,TAU);c.strokeStyle=color;c.lineWidth=width;c.stroke();
 }
 c.fillStyle='#fffef4';
 if(stopped){c.fillRect(-r*.2,-r*.2,r*.4,r*.4);c.restore();return;}
 // Two broad circular arrows retain a clear live label at the center.
 for(const angle of[-.65,Math.PI-.65]){
  c.save();c.rotate(angle);c.beginPath();c.arc(0,0,r*.73,-1.25,.92);c.arc(0,0,r*.5,.92,-1.25,true);c.closePath();c.fill();
  c.beginPath();c.moveTo(r*.41,r*.49);c.lineTo(r*.82,r*.38);c.lineTo(r*.61,r*.02);c.closePath();c.fill();c.restore();
 }
 c.textAlign='center';c.textBaseline='middle';c.font=`900 ${r*.145}px Arial`;
 c.fillText('HOLD',0,-r*.15);c.font=`900 ${r*.12}px Arial`;c.fillText('&',0,r*.03);
 c.font=`900 ${r*.145}px Arial`;c.fillText('SPIN',0,r*.21);c.restore();
}

export function drawHundredWinPanel(c,{amount=0,currency='ETB',x=126,y=590,w=168,h=34}={}) {
 c.save();c.beginPath();c.moveTo(x,y);c.lineTo(x+w,y);c.lineTo(x+w-9,y+h-4);
 c.quadraticCurveTo(x+w-11,y+h,x+w-18,y+h);c.lineTo(x+18,y+h);
 c.quadraticCurveTo(x+11,y+h,x+9,y+h-4);c.closePath();
 c.fillStyle='#043427';c.fill();c.strokeStyle='#817233';c.lineWidth=2;c.stroke();
 c.textAlign='center';c.textBaseline='middle';c.fillStyle='#dae385';c.font='900 8px Arial';c.fillText('WIN',x+w/2,y+9);
 c.fillStyle='#fff';c.font='900 10px Arial';c.fillText(money(amount)+' '+currency,x+w/2,y+21);c.restore();
}

function diamond(c,x,y,w,h,r) {
 c.beginPath();c.moveTo(x,y-h/2);c.quadraticCurveTo(x+r,y-h/2,x+w/2-r,y-r);
 c.quadraticCurveTo(x+w/2,y,x+w/2-r,y+r);c.lineTo(x+r,y+h/2-r);
 c.quadraticCurveTo(x,y+h/2,x-r,y+h/2-r);c.lineTo(x-w/2+r,y+r);
 c.quadraticCurveTo(x-w/2,y,x-w/2+r,y-r);c.lineTo(x-r,y-h/2+r);c.quadraticCurveTo(x,y-h/2,x,y-h/2);c.closePath();
}

// Shared Multi Hot win presentation. The amount is an animated view of the
// credited receipt; this function performs no wallet, wager or settlement work.
export function drawHundredWinBadge(c,{
 label='NICE WIN',amount=0,progress=1,x=210,y=357,w=234,h=223,
 currency='ETB',time=0,reducedMotion=false,dim=true
}={}) {
 const p=unit(progress),t=reducedMotion?0:finite(time)/1000;
 c.save();if(dim){c.fillStyle='#001322b5';c.fillRect(0,0,420,900);}
 c.save();c.translate(x,y);c.scale(w/234,h/223);
 // Rays are deterministic, so animation never changes the shown round result.
 c.save();c.rotate(t*.13);
 for(let i=0;i<32;i++){
  const a=i*TAU/32,length=95+(i%5)*12,inner=45+(i%3)*5;
  c.save();c.rotate(a);const ray=c.createLinearGradient(0,-inner,0,-length);
  ray.addColorStop(0,'#ffe39100');ray.addColorStop(.44,'#ffe78562');ray.addColorStop(1,'#fffed900');
  c.beginPath();c.moveTo(-3,-inner);c.lineTo(-1,-length);c.lineTo(2,-length-10);c.lineTo(3,-inner);c.closePath();c.fillStyle=ray;c.fill();c.restore();
 }
 c.restore();
 const haze=c.createRadialGradient(0,-13,15,0,-13,128);haze.addColorStop(0,'#fff19a73');haze.addColorStop(.5,'#ffe37c20');haze.addColorStop(1,'#ffe37c00');
 c.fillStyle=haze;c.fillRect(-145,-145,290,290);
 diamond(c,0,-15,211,193,10);c.shadowColor='#fff29b';c.shadowBlur=9;c.strokeStyle='#b8872b';c.lineWidth=11;c.stroke();c.shadowBlur=0;
 c.strokeStyle='#fff4af';c.lineWidth=6;c.stroke();c.strokeStyle='#a98232';c.lineWidth=2;c.stroke();
 const green=c.createLinearGradient(0,-110,0,90);green.addColorStop(0,'#118b3d');green.addColorStop(.4,'#087a2f');green.addColorStop(1,'#02562b');
 c.fillStyle=green;c.fill();diamond(c,0,-15,197,180,9);c.strokeStyle='#64bd5b';c.lineWidth=1.4;c.stroke();
 // Small gold crown sits inside the emblem, as in the supplied recording.
 c.beginPath();c.moveTo(-13,-83);c.lineTo(-9,-65);c.lineTo(9,-65);c.lineTo(13,-83);c.lineTo(4,-74);c.lineTo(0,-86);c.lineTo(-4,-74);c.closePath();
 const foil=c.createLinearGradient(0,-90,0,-64);foil.addColorStop(0,'#fffed9');foil.addColorStop(.45,'#fff488');foil.addColorStop(1,'#dca22e');c.fillStyle=foil;c.fill();
 const words=String(label).trim().split(/\s+/).slice(0,2);
 const first=words.length>1?words[0]:'',second=words.length>1?words[1]:words[0];
 c.font='900 39px Arial';c.textAlign='center';c.textBaseline='middle';c.lineJoin='round';
 for(const [word,yy]of[[first,-37],[second,2]]){
  if(!word)continue;c.strokeStyle='#43541b';c.lineWidth=4;c.strokeText(word,0,yy+2);
  const fill=c.createLinearGradient(0,yy-20,0,yy+20);fill.addColorStop(0,'#ffffbd');fill.addColorStop(.45,'#fff751');fill.addColorStop(1,'#f9c229');
  c.fillStyle=fill;c.fillText(word,0,yy);
 }
 c.beginPath();c.arc(0,56,31,Math.PI,TAU);c.lineTo(31,74);c.lineTo(-31,74);c.closePath();
 c.fillStyle='#a77820';c.fill();c.strokeStyle='#fff1ad';c.lineWidth=2;c.stroke();
 c.beginPath();c.arc(0,56,24,Math.PI,TAU);c.fillStyle='#e6c34c';c.fill();c.strokeStyle='#a07d29';c.lineWidth=2;c.stroke();
 // The medallion contains a small clover, separate from the changing value.
 c.fillStyle='#fff0a0';for(let i=0;i<3;i++){c.save();c.translate(0,56);c.rotate(i*TAU/3);c.beginPath();c.moveTo(0,0);c.bezierCurveTo(-17,-4,-12,-19,0,-10);c.bezierCurveTo(12,-19,17,-4,0,0);c.fill();c.restore();}
 c.beginPath();c.roundRect(-117,54,234,48,7);c.fillStyle='#9d711b';c.fill();c.strokeStyle='#fff1a5';c.lineWidth=3;c.stroke();
 c.beginPath();c.roundRect(-110,60,220,35,3);const purple=c.createLinearGradient(0,60,0,95);
 [[0,'#aa33f4'],[.17,'#6b0d98'],[.55,'#5a087d'],[.86,'#41065f'],[1,'#d552f5']].forEach(([at,color])=>purple.addColorStop(at,color));
 c.fillStyle=purple;c.fill();c.strokeStyle='#46144c';c.lineWidth=1;c.stroke();
 const shown=money(Math.max(0,finite(amount))*p);c.font='900 18px Arial';c.textAlign='center';c.textBaseline='middle';c.fillStyle='#fff8a8';c.shadowColor='#ffeaae55';c.shadowBlur=2;
 const amountWidth=c.measureText(shown).width;c.font='900 10px Arial';const unitWidth=c.measureText(currency).width,total=amountWidth+unitWidth+8;
 c.textAlign='left';c.font='900 18px Arial';c.fillText(shown,-total/2,78);c.font='900 10px Arial';c.fillText(currency,-total/2+amountWidth+8,80);
 c.restore();c.restore();return true;
}

// Isolated source components from the owner-supplied reference recordings.
// Fruits/title: VID_20261106_042200_788.mp4 7.5s; bell 19.5s.
// Single seven: owner-supplied Stars recording, clean first-row tile.
// Crops contain only one symbol or title; no grid, controls, balance or page.
export const hundredSourceArt={"title":"data:image/png;base64,","777":"data:image/png;base64,","grapes":"data:image/png;base64,","plum":"data:image/png;base64,","orange":"data:image/png;base64,","watermelon":"data:image/png;base64,","cherry":"data:image/png;base64,","golden_bell":"data:image/png;base64,","lemon":"data:image/png;base64,"};

// Isolated ready-state HOLD & SPIN face from the supplied MH100 recording.
// Circular alpha excludes the turbo icon, cabinet, balance and footer.
export const hundredIdleSpin="data:image/png;base64,";
