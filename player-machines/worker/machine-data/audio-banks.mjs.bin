// Existing Wild Multi Stars clips retained in the deployed Player worker.mjs.
// Selection changes presentation audio only; all other games retain their existing bank.
const stars={"win":"","bed":"","stop":"","spin":""};
export function getAudioSamples(gameId,defaults={}){
 if(gameId!=='wild_multi_stars')return defaults;
 return {...defaults,spin:stars.spin,'reel-loop':stars.bed,'reel-stop':stars.stop,'wheel-stop':stars.stop,win:stars.win,'big-win':stars.win};
}

